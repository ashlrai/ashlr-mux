    "product.window_lifecycle": {
      "rationale": "Creation, focus, close, events, and restore are implemented, but successful physical multi-display movement remains outside the retained headless differential evidence.",
      "status": "implemented_unverified"
    },
    "product.workspace_lifecycle": {
      "rationale": "The basic list/current/create/select/rename/close, next/previous/last, ordering, cross-window movement, and public workspace-group v2 and CLI entry points are exact across retained differentials. The broad umbrella still includes restore, persistence, remote workspaces, and workspace.action semantics that these lanes do not yet verify.",
      "status": "implemented_unverified"
    },
