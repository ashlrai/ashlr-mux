    {"op": "v2", "method": "workspace.create", "params": {"window_id": "${session.2.result.window_id}", "title": "gamma-two", "focus": false}},
    {"op": "v2", "method": "workspace.create", "params": {"window_id": "${session.2.result.window_id}", "title": "gamma-three", "focus": false}}
  ],
