    {"op": "v2", "method": "window.create", "params": {}},
    {"op": "v2", "method": "window.create", "params": {}},
    {"op": "v2", "method": "workspace.list", "params": {"window_id": "${session.0.result.window_id}"}},
    {"op": "v2", "method": "workspace.list", "params": {"window_id": "${session.1.result.window_id}"}},
