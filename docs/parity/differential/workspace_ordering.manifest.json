    {"op": "v2", "method": "workspace.list", "params": {"window_id": "${session.3.result.window_id}"}},
    {"op": "v2", "method": "workspace.create", "params": {"window_id": "${session.0.result.window_id}", "title": "alpha-two", "focus": false}},
