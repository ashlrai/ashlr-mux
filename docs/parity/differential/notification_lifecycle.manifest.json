      "approved_differences": [
        {
          "path": "/events/1/payload/cwd",
          "rationale": "The exact workspace.selected event carries the platform-specific isolated capture working directory; navigation identity, index, title, selection, event order, and all non-path fields stay strict."
        },
        {
          "path": "/events/2/payload/previous_surface_id",
          "rationale": "The pre-navigation boot surface is a canonical UUID but the Windows bootstrap surface retains the stable legacy id surface-1; target surface and workspace identity, pane identity, focus semantics, event order, and all subsequent notification fields stay strict."
        }
      ],
