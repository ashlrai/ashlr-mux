{
  "family": "notification_lifecycle",
  "canonical_commit": "e1825d40d52b4ae4f4bcb0b7e0dfc744dd20a452",
  "notes": [
    "Exercises the seven implemented-but-unverified public notification v2 methods and their seven CLI entry points against one deterministic workspace/surface fixture.",
    "Each id-targeted case clears and reseeds the notification store before resolving the generated notification UUID from notification.list, avoiding assumptions about UUIDs or retained ordering.",
    "The lane covers payloads, defaults, selector validation, not-found behavior, read/dismiss/clear mutations, target navigation, CLI help and output, state probes, and lifecycle events.",
    "The first matched run classified only two platform bootstrap values in notification.open_target; all notification behavior and remaining event fields stay strict."
  ],
  "session_setup": [
    {"op": "v2", "method": "workspace.create", "params": {"title": "notification-lifecycle"}},
    {"op": "v2", "method": "surface.create", "params": {"workspace_id": "${session.0.result.workspace_id}", "type": "terminal"}}
  ],
  "cases": [
