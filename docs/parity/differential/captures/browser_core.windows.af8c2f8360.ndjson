{"approved_differences": [{"path": "/response/result/page/text", "rationale": "WKWebView and WebView2 serialize body.innerText whitespace and select-option line breaks differently; the scoped accessibility snapshot, refs, page HTML, title, URL, ready state, locator behavior, and all DOM mutations remain exact."}], "capture_error": null, "id": "browser.snapshot_interactive", "observation": {"error": null, "events": null, "exit_status": null, "multiwindow": null, "persistence": null, "response": {"id": 1, "ok": true, "result": {"page": {"html": "<html lang=\"en\"><head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Parity Browser</title>\n  <style>\n    :root { color-scheme: light; }\n    body { margin: 0; font: 16px/1.4 sans-serif; }\n    #fixture { padding: 24px; }\n    #hover-target { width: 120px; height: 32px; }\n    #hidden { display: none; }\n    #scroll-spacer { height: 1400px; }\n    #scroll-target { height: 32px; }\n  </style>\n</head>\n<body data-clicks=\"0\" data-doubles=\"0\" data-hovered=\"false\">\n  <main id=\"fixture\">\n    <section id=\"snapshot-root\" aria-label=\"Parity controls\">\n      <h1 id=\"heading\" data-kind=\"headline\">Hello parity</h1>\n      <p><span id=\"locator-text\">Locator needle</span></p>\n\n      <label for=\"name\">Display name</label>\n      <input id=\"name\" name=\"name\" placeholder=\"Your name\" value=\"start\">\n\n      <button id=\"activate\" type=\"button\" title=\"Primary action\" data-testid=\"activate-control\">Activate parity</button>\n      <button id=\"disabled\" type=\"button\" disabled=\"\">Disabled action</button>\n      <button id=\"hover-target\" type=\"button\">Hover target</button>\n\n      <label><input id=\"check\" type=\"checkbox\"> Enable parity</label>\n      <label for=\"choice\">Parity choice</label>\n      <select id=\"choice\">\n        <option value=\"alpha\">Alpha</option>\n        <option value=\"beta\">Beta</option>\n      </select>\n\n      <input id=\"key-target\" aria-label=\"Keyboard target\" value=\"\">\n      <img id=\"logo\" alt=\"Parity logo\" title=\"Parity image\" width=\"1\" height=\"1\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACw=\">\n      <output id=\"status\" role=\"status\">ready</output>\n      <div id=\"hidden\">not visible</div>\n\n      <ul id=\"items\">\n        <li class=\"item\">First item</li>\n        <li class=\"item\">Second item</li>\n        <li class=\"item\">Third item</li>\n      </ul>\n    </section>\n\n    <div id=\"scroll-spacer\"></div>\n    <div id=\"scroll-target\" tabindex=\"-1\">Scroll destination</div>\n  </main>\n  <script>\n    (() => {\n      const body = document.body;\n      const status = document.getElementById('status');\n      const activate = document.getElementById('activate');\n      const hoverTarget = document.getElementById('hover-target');\n      const keyTarget = document.getElementById('key-target');\n\n      activate.addEventListener('click', () => {\n        body.dataset.clicks = String(Number(body.dataset.clicks) + 1);\n        status.textContent = `clicked:${body.dataset.clicks}`;\n      });\n      activate.addEventListener('dblclick', () => {\n        body.dataset.doubles = String(Number(body.dataset.doubles) + 1);\n        status.textContent = `double:${body.dataset.doubles}`;\n      });\n      hoverTarget.addEventListener('mouseover', () => {\n        body.dataset.hovered = 'true';\n      });\n      keyTarget.addEventListener('keydown', (event) => {\n        body.dataset.keydown = event.key;\n      });\n      keyTarget.addEventListener('keyup', (event) => {\n        body.dataset.keyup = event.key;\n      });\n    })();\n  </script>\n\n\n</body></html>", "ready_state": "complete", "text": "Hello parity\n\nLocator needle\n\nDisplay name  Activate parity Disabled action Hover target  Enable parity Parity choice \nAlpha\nBeta\n   ready\nFirst item\nSecond item\nThird item\nScroll destination", "title": "Parity Browser", "url": "http://127.0.0.1:43123/fixtures/browser-core.html"}, "ready_state": "complete", "refs": {"e1": {"name": "Your name", "role": "textbox"}, "e2": {"name": "Primary action", "role": "button"}, "e3": {"name": "Disabled action", "role": "button"}, "e4": {"name": "Hover target", "role": "button"}, "e5": {"name": "on", "role": "checkbox"}, "e6": {"name": "Alpha Beta", "role": "combobox"}, "e7": {"name": "Keyboard target", "role": "textbox"}}, "snapshot": "- document \"Parity Browser\"\n  - textbox \"Your name\" [ref=e1]\n  - button \"Primary action\" [ref=e2]\n  - button \"Disabled action\" [ref=e3]\n  - button \"Hover target\" [ref=e4]\n    - checkbox \"on\" [ref=e5]\n  - combobox \"Alpha Beta\" [ref=e6]\n  - textbox \"Keyboard target\" [ref=e7]", "surface_id": "<uuid-5>", "surface_ref": "surface:3", "title": "Parity Browser", "url": "http://127.0.0.1:43123/fixtures/browser-core.html", "workspace_id": "<uuid-3>", "workspace_ref": "workspace:2"}}, "selectors": null, "state": null, "stderr": null, "stdout": null}, "platform": "windows", "type": "case"}
