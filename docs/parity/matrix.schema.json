{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmux.dev/schemas/windows-parity-matrix.json",
  "title": "ashlr-mux Windows parity matrix",
  "type": "object",
  "required": ["schema_version", "baseline", "entries", "summary"],
  "properties": {
    "schema_version": { "const": 1 },
    "baseline": {
      "type": "object",
      "required": ["canonical_commit", "windows_commit"],
      "properties": {
        "canonical_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "windows_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      },
      "additionalProperties": true
    },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    },
    "summary": { "type": "object" }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "line": { "type": ["integer", "null"], "minimum": 1 },
        "symbol": { "type": ["string", "null"] },
        "commit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" }
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "domain",
        "family",
        "name",
        "canonical_sources",
        "windows_sources",
        "status",
        "acceptance_tests",
        "dependencies",
        "priority",
        "batch",
        "latest_verifying_commit"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["cli_command", "cli_contract", "v2_method", "product_behavior"]
        },
        "domain": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "canonical_sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        },
        "windows_sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/source" }
        },
        "status": {
          "enum": [
            "missing",
            "red",
            "implemented_unverified",
            "verified",
            "platform_equivalent",
            "not_applicable"
          ]
        },
        "acceptance_tests": { "type": "array", "items": { "type": "string" } },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "priority": { "type": "integer", "minimum": 0, "maximum": 4 },
        "batch": { "type": "string", "minLength": 1 },
        "latest_verifying_commit": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}$"
        },
        "rationale": { "type": ["string", "null"] },
        "user_approval": { "type": ["string", "null"] },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
