{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability set for the cmux desktop bootstrap shell.",
  "windows": ["main", "window-*"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-create",
    "core:window:allow-set-fullscreen",
    "core:webview:allow-create-webview-window",
    "dialog:default"
  ]
}
